{
  "name": "meetu-slack-bot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --experimental-sqlite dist/app.js",
    "test": "npm run build && node --experimental-sqlite --test --test-concurrency=1 dist/test/*.test.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": { "node": ">=22.5" },
  "dependencies": {
    "@slack/bolt": "^4.4.0",
    "@stomp/stompjs": "^7.1.1",
    "dotenv": "^17.2.1",
    "ws": "^8.18.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.15.30",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
